# ============================================================
# ApartmentSaaS - Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (MySQL 8 InnoDB) ---
DATABASE_URL="mysql://apartment_user:your_password_here@localhost:3306/apartment_saas"

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Authentication & JWT ---
# Generate strong 64-char secrets: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_very_long_random_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# --- Platform Admin Initial Bootstrap (Seed) ---
# In production, both are mandatory and password must be strong (>= 12 chars).
BOOTSTRAP_ADMIN_EMAIL=admin@apartmentsaas.com
BOOTSTRAP_ADMIN_PASSWORD=AdminSecure123!
BOOTSTRAP_ADMIN_NAME="Platform Administrator"

# --- Frontend (Vite - must prefix with VITE_) ---
VITE_API_URL=http://localhost:3001

# --- Docker Compose MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_DATABASE=apartment_saas
MYSQL_USER=apartment_user
MYSQL_PASSWORD=your_password_here
